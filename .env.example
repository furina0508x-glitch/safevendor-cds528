# Sepolia JSON-RPC. The public endpoint is a reasonable fallback for tests.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Test-only private key. Never use a wallet holding real assets.
PRIVATE_KEY=

# Optional comma-separated owner addresses. If omitted, deploy.js uses
# PRIVATE_KEY plus up to two additional addresses exported in OWNER_2 and OWNER_3.
TREASURY_OWNERS=
OWNER_2=
OWNER_3=

# Used by scripts/demo-flow.js and scripts/verify.js.
OWNER_2_PRIVATE_KEY=

# Required only for Etherscan contract verification.
ETHERSCAN_API_KEY=
